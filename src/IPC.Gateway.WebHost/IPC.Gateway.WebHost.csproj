<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeCommercialDriverPlugin Condition="'$(IncludeCommercialDriverPlugin)' == '' and Exists('..\IPC.Gateway.LegacyProtocolPlugins\IPC.Gateway.LegacyProtocolPlugins.csproj')">true</IncludeCommercialDriverPlugin>
    <IncludeCommercialDriverPlugin Condition="'$(IncludeCommercialDriverPlugin)' == ''">false</IncludeCommercialDriverPlugin>
    <ProtocolDriverBuildDir>$(MSBuildProjectDirectory)/../IPC.Gateway.LegacyProtocolPlugins/bin/$(Configuration)/net10.0/$(RuntimeIdentifier)</ProtocolDriverBuildDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPC.Gateway.Core\IPC.Gateway.Core.csproj" />
    <ProjectReference Include="..\IPC.Gateway.HighAvailability\IPC.Gateway.HighAvailability.csproj" />
    <ProjectReference Include="..\IPC.Gateway.Arbiter\IPC.Gateway.Arbiter.csproj" />
    <ProjectReference Include="..\IPC.Gateway.HaSetup\Provisioning\IPC.Gateway.HaProvisioning.csproj" />
    <ProjectReference Include="..\IPC.Gateway.FlowRules\IPC.Gateway.FlowRules.csproj" />
    <ProjectReference Include="..\IPC.Gateway.Inference\IPC.Gateway.Inference.csproj" />
    <ProjectReference Include="..\IPC.Gateway.Scripting\IPC.Gateway.Scripting.csproj" />
    <ProjectReference Include="..\IPC.Gateway.Watchdog\IPC.Gateway.Watchdog.csproj" />
    <ProjectReference Include="..\IPC.Gateway.LegacyProtocolPlugins\IPC.Gateway.LegacyProtocolPlugins.csproj" ReferenceOutputAssembly="false" Condition="'$(IncludeCommercialDriverPlugin)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <DependentUpon>appsettings.json</DependentUpon>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Development.example.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\IPC.Gateway.Web\dist\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PinHaGuardedProtocolDriver" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveProjectReferences" Condition="'$(IncludeCommercialDriverPlugin)' == 'true'">
    <GetFileHash Files="$(ProtocolDriverBuildDir)/IPC.Gateway.LegacyProtocolPlugins.dll" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HaGuardedDriver" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyMetadata Include="HaGuardedProtocolPluginSha256" Value="%(_HaGuardedDriver.FileHash)" />
    </ItemGroup>
  </Target>

  <Target Name="PublishProtocolDrivers" AfterTargets="Publish" Condition="'$(IncludeCommercialDriverPlugin)' == 'true'">
    <ItemGroup>
      <ProtocolDriverPublishFiles Include="$(ProtocolDriverBuildDir)/*.*" Exclude="$(ProtocolDriverBuildDir)/IPC.Gateway.Core.*;$(ProtocolDriverBuildDir)/IPC.Gateway.DataProcessing.*;$(ProtocolDriverBuildDir)/IPC.Gateway.Mqtt.*" />
      <ProtocolDriverRuntimeFiles Include="$(ProtocolDriverBuildDir)/runtimes/**/*.*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)Drivers" />
    <Copy SourceFiles="@(ProtocolDriverPublishFiles)" DestinationFolder="$(PublishDir)Drivers" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ProtocolDriverRuntimeFiles)" DestinationFolder="$(PublishDir)Drivers\runtimes\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The standalone witness ships its own configuration example in components/. -->
  <Target Name="ExcludeWitnessConfigurationExample" AfterTargets="ComputeFilesToPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <PropertyGroup>
      <WitnessExamplePath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../IPC.Gateway.Arbiter/appsettings.Production.example.json'))</WitnessExamplePath>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.FullPath)' == '$(WitnessExamplePath)'" />
    </ItemGroup>
  </Target>

</Project>
