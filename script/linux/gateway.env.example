# Merge into /etc/ipc-gateway/ipc-gateway.env (systemd KEY=value syntax).
Gateway__Database__Provider=SqlServer
Gateway__Database__ConnectionString="Server=192.168.1.10,1433;Database=ipc_gateway;User Id=ipc_gateway;Password=replace-me;Encrypt=True;TrustServerCertificate=True"
Gateway__Auth__Secret=replace-with-at-least-32-random-characters
Gateway__Security__SecretStorage__MasterKey=replace-with-a-stable-random-master-key
Gateway__Auth__BootstrapAdminPassword=ReplaceThisPassword1!
# On migration retain the existing auth/master keys and the existing database.
