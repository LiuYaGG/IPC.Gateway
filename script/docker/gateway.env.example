# Copy to gateway.env; configure the database reachable FROM THE CONTAINER.
# 127.0.0.1 refers to the container. Use a LAN address or host.docker.internal.
Gateway__Database__Provider=SqlServer
Gateway__Database__ConnectionString='Server=host.docker.internal,1433;Database=ipc_gateway;User Id=ipc_gateway;Password=replace-me;Encrypt=True;TrustServerCertificate=True'
Gateway__Auth__Secret=replace-with-at-least-32-random-characters
Gateway__Security__SecretStorage__MasterKey=replace-with-a-stable-random-master-key
Gateway__Auth__BootstrapAdminPassword=ReplaceThisPassword1!
# Preserve these keys and the same Docker project name on upgrades.
IPC_GATEWAY_HTTP_PORT=5184
