map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream ipc_gateway_webhost {
    server 127.0.0.1:5184;
    keepalive 32;
}

server {
    listen 80;
    server_name ipc-gateway.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ipc-gateway.example.com;

    ssl_certificate /etc/nginx/certs/ipc-gateway.crt;
    ssl_certificate_key /etc/nginx/certs/ipc-gateway.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 20m;
    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    location / {
        proxy_pass http://ipc_gateway_webhost;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
