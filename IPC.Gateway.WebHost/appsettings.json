{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Runtime": {
      "AutoCreateDefaultProject": true,
      "IsolationStrategy": "SemaphoreLimitedPerDeviceQueue",
      "MaxConcurrentDevicePolls": 8,
      "SchedulerIntervalMs": 100,
      "DevicePollQueueLimit": 1024,
      "BackpressureEnabled": true,
      "QueueHighWatermarkPercent": 80,
      "QueueLowWatermarkPercent": 50,
      "BackpressureDelayMs": 500,
      "MaxDevicePollsQueuedPerSchedulerTick": 0,
      "SlowPollThresholdMs": 5000,
      "PollTimeoutMs": 10000,
      "DeviceStatusFailureDebounceCount": 3,
      "DeviceStatusFailureDebounceMs": 2000,
      "DeviceStatusRecoveryDebounceCount": 1,
      "DeviceStatusRecoveryDebounceMs": 0,
      "TagValueChangedQueueLimit": 100000
    },
    "Reliability": {
      "Enabled": true,
      "DegradedCpuUsagePercent": 85,
      "UnhealthyCpuUsagePercent": 95,
      "DegradedMemoryUsagePercent": 85,
      "UnhealthyMemoryUsagePercent": 95,
      "DegradedAvailableThreadPoolWorkers": 8,
      "UnhealthyAvailableThreadPoolWorkers": 2
    },
    "Observability": {
      "MetricsEnabled": true,
      "PrometheusPath": "/metrics",
      "MeterName": "IPC.Gateway"
    },
    "License": {
      "ProductId": "IPC.Gateway",
      "LicenseFile": "Data/License/ipc-gateway-license.json",
      "LicenseText": "",
      "TrustedPublicKeyPem": "",
      "TrustedPublicKeyFile": "Data/License/ipc-gateway-license-public.pem",
      "RequireValidLicense": false,
      "RequireMachineBinding": true,
      "MachineIdOverride": ""
    },
    "ProtocolDrivers": {
      "RequireSignature": false,
      "TrustedPublicKeyPem": ""
    },
    "Resilience": {
      "RuleEngine": {
        "Enabled": true,
        "FailureThreshold": 10,
        "SuccessThreshold": 2,
        "BreakDurationSeconds": 30,
        "DegradedMode": "SkipEvaluation"
      },
      "Mqtt": {
        "Enabled": true,
        "FailureThreshold": 5,
        "SuccessThreshold": 1,
        "BreakDurationSeconds": 30,
        "DegradedMode": "OutboxOnly"
      },
      "History": {
        "Enabled": true,
        "FailureThreshold": 3,
        "SuccessThreshold": 1,
        "BreakDurationSeconds": 60,
        "DegradedMode": "DropWrites"
      },
      "ProtocolDriver": {
        "Enabled": true,
        "FailureThreshold": 3,
        "SuccessThreshold": 1,
        "BreakDurationSeconds": 30,
        "DegradedMode": "SkipDevicePoll"
      }
    },
    "Database": {
      "Provider": "SqlServer",
      "ConnectionString": "",
      "Host": "127.0.0.1",
      "Port": 1433,
      "Database": "ipc_gateway",
      "Username": "sa",
      "Password": "123",
      "AutoCreateDatabase": true
    },
    "Auth": {
      "Secret": "",
      "TokenHours": 12,
      "AutoCreateAdmin": true,
      "BootstrapAdminUsername": "admin",
      "BootstrapAdminDisplayName": "System Administrator",
      "BootstrapAdminPassword": ""
    },
    "Audit": {
      "RetentionDays": 180
    },
    "Security": {
      "PasswordPolicy": {
        "Enabled": true,
        "MinLength": 8,
        "MaxLength": 128,
        "RequireUppercase": false,
        "RequireLowercase": true,
        "RequireDigit": true,
        "RequireSymbol": true,
        "RejectUsernameInPassword": true
      },
      "AccountLockout": {
        "Enabled": true,
        "MaxFailedAttempts": 5,
        "LockoutMinutes": 15,
        "ResetFailedCountOnSuccess": true
      },
      "Tls": {
        "RequireHttps": false,
        "EnableHttpsRedirection": false,
        "EnableHsts": false,
        "HstsMaxAgeDays": 180,
        "CertificatePath": "",
        "CertificatePassword": "",
        "HttpsPort": 0,
        "MinimumProtocol": "Tls12"
      },
      "Api": {
        "RequireAuthenticationForHealth": false,
        "AuditUnauthorizedRequests": true,
        "AuditForbiddenRequests": true,
        "AuditConfigurationRequestHash": true,
        "MaxAuditedBodyBytes": 1048576
      },
      "ApiTokens": {
        "Enabled": true,
        "HeaderName": "X-API-Token",
        "RequireHttps": false,
        "Tokens": []
      },
      "SecretStorage": {
        "Enabled": true,
        "MasterKey": "",
        "EnvironmentVariableName": "IPC_GATEWAY_SECRET_KEY"
      },
      "Certificates": {
        "IncludeTlsCertificate": true,
        "IncludeOpcUaCertificateStore": true,
        "ExpiringSoonDays": 30
      }
    },
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": []
    },
    "Maintenance": {
      "Updates": {
        "Enabled": true,
        "ProductId": "IPC.Gateway",
        "UpdateDirectory": "Data/Updates",
        "InstallDirectory": "",
        "MaxPackageMegabytes": 1024,
        "KeepRollbackCount": 5,
        "RequirePackageFileDigests": true,
        "RequirePackageSignature": false,
        "TrustedPackagePublicKeyPath": "",
        "TrustedPackagePublicKeyPem": "",
        "PreservePaths": [
          "Data",
          "appsettings.json",
          "appsettings.Production.json",
          "appsettings.Development.json"
        ]
      }
    },
    "Watchdog": {
      "Enabled": true,
      "CheckIntervalSeconds": 10,
      "StartupGraceSeconds": 30,
      "RuntimeNoProgressSeconds": 180,
      "RecoveryCooldownSeconds": 60,
      "RecoveryTimeoutSeconds": 30,
      "MaxRecoveriesPerWindow": 3,
      "RecoveryWindowMinutes": 10,
      "RequestHostStopOnUnrecoverable": false,
      "MaxHostRestartRequestsPerWindow": 2,
      "HostRestartProtectionWindowMinutes": 30,
      "StateDirectory": "Data/Watchdog",
      "MonitorMqtt": true,
      "MqttDisconnectedSeconds": 300,
      "MonitorHistory": true,
      "MonitorRuleEngine": true,
      "MonitorOpcUa": true,
      "MonitorScheduler": true
    },
    "Mqtt": {
      "Enabled": false,
      "GatewayId": "IPC-Gateway-Web",
      "GatewayName": "IPC Gateway Web",
      "SiteName": "",
      "CloudProtocolVersion": "ipc.gateway.v1",
      "ConfigVersion": 1,
      "PublishMode": "Classic",
      "Host": "localhost",
      "Port": 1883,
      "ClientId": "IPC-Gateway-Web",
      "UseTls": false,
      "AllowUntrustedCertificates": false,
      "ClientCertificatePath": "",
      "ClientCertificatePassword": "",
      "ClientCertificateThumbprint": "",
      "ServerCertificateThumbprint": "",
      "CaCertificatePath": "",
      "SubscribeTopic": "gateway/IPC-Gateway-Web/config",
      "PublishEnabled": true,
      "PublishTopicTemplate": "ipc/data/{channel}/{device}/{group}/{tag}",
      "PublishQos": 0,
      "HeartbeatEnabled": true,
      "HeartbeatIntervalSeconds": 60,
      "HeartbeatTopic": "gateway/{gatewayId}/heartbeat",
      "StatusTopic": "gateway/{gatewayId}/status",
      "OutboxDirectory": "Data/MqttOutbox",
      "OutboxMaxMessages": 10000,
      "OutboxMaxMegabytes": 100,
      "OutboxRetentionHours": 168,
      "OutboxQuarantineRetentionHours": 720,
      "SparkplugNamespace": "spBv1.0",
      "SparkplugGroupId": "IPC-Gateway-Web",
      "SparkplugEdgeNodeId": "IPC-Gateway-Web",
      "SparkplugDeviceIdSource": "DeviceId",
      "SparkplugMetricNameTemplate": "{channel}/{group}/{tag}",
      "SparkplugPublishNodeBirth": true,
      "SparkplugPublishDeviceBirth": true,
      "SparkplugPublishDeviceDeath": true,
      "SparkplugIncludeProperties": true,
      "SparkplugUseAliases": false,
      "SparkplugDeathQos": 0,
      "SparkplugBirthQos": 0
    },
    "OpcUa": {
      "Enabled": false,
      "ApplicationName": "IPC Gateway OPC UA Server",
      "ApplicationUri": "urn:ipc-gateway:opcua",
      "ProductUri": "urn:ipc-gateway",
      "Host": "0.0.0.0",
      "Port": 4840,
      "EndpointPath": "IPC.Gateway",
      "NamespaceUri": "urn:ipc-gateway:tags",
      "CertificateStorePath": "Data/OpcUa/pki",
      "AutoAcceptUntrustedCertificates": true,
      "AllowAnonymous": true,
      "UsernamePasswordEnabled": false,
      "Username": "",
      "UserPasswordHash": "",
      "UserPasswordSalt": "",
      "UserPasswordAlgorithm": "PBKDF2-SHA256",
      "SecurityPolicy": "None",
      "AllowSecurityPolicyNone": true,
      "EnableBasic256SignAndEncrypt": false,
      "EnableBasic256Sha256SignAndEncrypt": false,
      "MinimumSamplingIntervalMs": 250,
      "PublishDiagnostics": true
    },
    "History": {
      "Enabled": true,
      "Directory": "Data/History",
      "RetentionDays": 7,
      "MaxViewRecords": 500,
      "BatchWriteEnabled": true,
      "BatchFlushIntervalMs": 1000,
      "BatchMaxLines": 1000,
      "BatchQueueLimit": 100000
    },
    "StorageHealth": {
      "DegradedAvailableMegabytes": 1024,
      "UnhealthyAvailableMegabytes": 256,
      "DegradedAvailablePercent": 10,
      "UnhealthyAvailablePercent": 2
    }
  }
}
