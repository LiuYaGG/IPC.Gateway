<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPC.Gateway.Core\IPC.Gateway.Core.csproj" />
    <ProjectReference Include="..\IPC.Gateway.FlowRules\IPC.Gateway.FlowRules.csproj" />
    <ProjectReference Include="..\IPC.Gateway.Inference\IPC.Gateway.Inference.csproj" />
    <ProjectReference Include="..\IPC.Gateway.Watchdog\IPC.Gateway.Watchdog.csproj" />
    <ProjectReference Include="..\IPC.Gateway.LegacyProtocolPlugins\IPC.Gateway.LegacyProtocolPlugins.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\IPC.Gateway.Web\dist\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PublishProtocolDrivers" AfterTargets="Publish">
    <ItemGroup>
      <ProtocolDriverPublishFiles Include="..\IPC.Gateway.LegacyProtocolPlugins\bin\$(Configuration)\net10.0\*.*"
                                  Exclude="..\IPC.Gateway.LegacyProtocolPlugins\bin\$(Configuration)\net10.0\IPC.Gateway.Core.*;..\IPC.Gateway.LegacyProtocolPlugins\bin\$(Configuration)\net10.0\IPC.Gateway.DataProcessing.*;..\IPC.Gateway.LegacyProtocolPlugins\bin\$(Configuration)\net10.0\IPC.Gateway.Mqtt.*" />
      <ProtocolDriverRuntimeFiles Include="..\IPC.Gateway.LegacyProtocolPlugins\bin\$(Configuration)\net10.0\runtimes\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)Drivers" />
    <Copy SourceFiles="@(ProtocolDriverPublishFiles)"
          DestinationFolder="$(PublishDir)Drivers"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ProtocolDriverRuntimeFiles)"
          DestinationFolder="$(PublishDir)Drivers\runtimes\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
