{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Mqtt": {
      "Enabled": false,
      "GatewayId": "IPC-Gateway-Web",
      "GatewayName": "IPC Gateway Web",
      "Host": "localhost",
      "Port": 1883,
      "ClientId": "IPC-Gateway-Web",
      "SubscribeTopic": "gateway/IPC-Gateway-Web/config",
      "PublishEnabled": true,
      "PublishTopicTemplate": "ipc/data/{device}/{group}/{tag}",
      "PublishQos": 0,
      "HeartbeatEnabled": true,
      "HeartbeatIntervalSeconds": 60,
      "HeartbeatTopic": "gateway/{gatewayId}/heartbeat",
      "StatusTopic": "gateway/{gatewayId}/status",
      "OutboxDirectory": "Data/MqttOutbox"
    },
    "History": {
      "Enabled": true,
      "Directory": "Data/History",
      "RetentionDays": 7,
      "MaxViewRecords": 500
    }
  }
}
