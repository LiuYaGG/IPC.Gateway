{
  "AllowedHosts": "ipc-gateway.example.com",
  "Gateway": {
    "Runtime": {
      "BackpressureEnabled": true,
      "QueueHighWatermarkPercent": 80,
      "QueueLowWatermarkPercent": 50,
      "BackpressureDelayMs": 500,
      "MaxDevicePollsQueuedPerSchedulerTick": 0
    },
    "Resilience": {
      "RuleEngine": {
        "Enabled": true,
        "FailureThreshold": 10,
        "SuccessThreshold": 2,
        "BreakDurationSeconds": 30,
        "DegradedMode": "SkipEvaluation"
      },
      "Mqtt": {
        "Enabled": true,
        "FailureThreshold": 5,
        "SuccessThreshold": 1,
        "BreakDurationSeconds": 30,
        "DegradedMode": "OutboxOnly"
      },
      "History": {
        "Enabled": true,
        "FailureThreshold": 3,
        "SuccessThreshold": 1,
        "BreakDurationSeconds": 60,
        "DegradedMode": "DropWrites"
      },
      "ProtocolDriver": {
        "Enabled": true,
        "FailureThreshold": 3,
        "SuccessThreshold": 1,
        "BreakDurationSeconds": 30,
        "DegradedMode": "SkipDevicePoll"
      }
    },
    "Database": {
      "Provider": "PostgreSQL",
      "ConnectionString": "",
      "Host": "postgres.internal",
      "Port": 5432,
      "Database": "ipc_gateway",
      "Username": "ipc_gateway",
      "Password": "",
      "AutoCreateDatabase": false
    },
    "Auth": {
      "Secret": "",
      "TokenHours": 12,
      "AutoCreateAdmin": true,
      "BootstrapAdminUsername": "admin",
      "BootstrapAdminDisplayName": "System Administrator",
      "BootstrapAdminPassword": ""
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [
        "127.0.0.1",
        "::1"
      ],
      "KnownNetworks": []
    },
    "Audit": {
      "RetentionDays": 180
    },
    "Security": {
      "SecretStorage": {
        "Enabled": true,
        "MasterKey": "",
        "EnvironmentVariableName": "IPC_GATEWAY_SECRET_KEY"
      },
      "ApiTokens": {
        "Enabled": true,
        "HeaderName": "X-API-Token",
        "RequireHttps": true,
        "Tokens": [
          {
            "Name": "mes-readonly",
            "Enabled": true,
            "TokenHash": "",
            "Role": "ApiToken",
            "Permissions": [
              "runtime.view",
              "config.read"
            ],
            "ExpiresUtc": "1970-01-01T00:00:00Z"
          }
        ]
      },
      "Tls": {
        "RequireHttps": true,
        "EnableHttpsRedirection": true,
        "EnableHsts": true,
        "CertificatePath": "",
        "CertificatePassword": "",
        "HttpsPort": 443,
        "MinimumProtocol": "Tls12"
      }
    },
    "Mqtt": {
      "UseTls": true,
      "AllowUntrustedCertificates": false,
      "ClientCertificatePath": "",
      "ClientCertificatePassword": "",
      "ClientCertificateThumbprint": "",
      "ServerCertificateThumbprint": "",
      "CaCertificatePath": ""
    },
    "Maintenance": {
      "Updates": {
        "Enabled": true,
        "ProductId": "IPC.Gateway",
        "UpdateDirectory": "Data/Updates",
        "InstallDirectory": "",
        "MaxPackageMegabytes": 1024,
        "KeepRollbackCount": 5,
        "PreservePaths": [
          "Data",
          "appsettings.json",
          "appsettings.Production.json",
          "appsettings.Development.json"
        ]
      }
    },
    "Watchdog": {
      "Enabled": true,
      "CheckIntervalSeconds": 10,
      "StartupGraceSeconds": 30,
      "RuntimeNoProgressSeconds": 180,
      "RecoveryCooldownSeconds": 60,
      "RecoveryTimeoutSeconds": 30,
      "MaxRecoveriesPerWindow": 3,
      "RecoveryWindowMinutes": 10,
      "RequestHostStopOnUnrecoverable": true,
      "MaxHostRestartRequestsPerWindow": 2,
      "HostRestartProtectionWindowMinutes": 30,
      "StateDirectory": "Data/Watchdog",
      "MonitorMqtt": true,
      "MqttDisconnectedSeconds": 300,
      "MonitorHistory": true,
      "MonitorRuleEngine": true,
      "MonitorOpcUa": true,
      "MonitorScheduler": true
    },
    "History": {
      "Enabled": true,
      "Directory": "Data/History",
      "RetentionDays": 30,
      "MaxViewRecords": 500
    },
    "StorageHealth": {
      "DegradedAvailableMegabytes": 4096,
      "UnhealthyAvailableMegabytes": 1024,
      "DegradedAvailablePercent": 10,
      "UnhealthyAvailablePercent": 2
    }
  }
}
