{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "Runtime": {
      "BackpressureEnabled": true,
      "QueueHighWatermarkPercent": 80,
      "QueueLowWatermarkPercent": 50,
      "BackpressureDelayMs": 500,
      "MaxDevicePollsQueuedPerSchedulerTick": 0
    },
    "Resilience": {
      "RuleEngine": {
        "Enabled": true,
        "FailureThreshold": 10,
        "SuccessThreshold": 2,
        "BreakDurationSeconds": 30,
        "DegradedMode": "SkipEvaluation"
      },
      "Mqtt": {
        "Enabled": true,
        "FailureThreshold": 5,
        "SuccessThreshold": 1,
        "BreakDurationSeconds": 30,
        "DegradedMode": "OutboxOnly"
      },
      "History": {
        "Enabled": true,
        "FailureThreshold": 3,
        "SuccessThreshold": 1,
        "BreakDurationSeconds": 60,
        "DegradedMode": "DropWrites"
      },
      "ProtocolDriver": {
        "Enabled": true,
        "FailureThreshold": 3,
        "SuccessThreshold": 1,
        "BreakDurationSeconds": 30,
        "DegradedMode": "SkipDevicePoll"
      }
    },
    "Database": {
      "Password": "123"
    },
    "Auth": {
      "Secret": "development-only-auth-secret-please-replace-in-production",
      "BootstrapAdminPassword": "Admin#12345678"
    },
    "Security": {
      "PasswordPolicy": {
        "Enabled": true,
        "MinLength": 8,
        "RequireUppercase": false,
        "RequireLowercase": true,
        "RequireDigit": true,
        "RequireSymbol": true
      },
      "AccountLockout": {
        "Enabled": true,
        "MaxFailedAttempts": 5,
        "LockoutMinutes": 15
      },
      "Tls": {
        "RequireHttps": false,
        "EnableHttpsRedirection": false,
        "EnableHsts": false
      },
      "ApiTokens": {
        "Enabled": true,
        "HeaderName": "X-API-Token",
        "RequireHttps": false,
        "Tokens": []
      },
      "SecretStorage": {
        "Enabled": true,
        "MasterKey": "",
        "EnvironmentVariableName": "IPC_GATEWAY_SECRET_KEY"
      }
    },
    "Maintenance": {
      "Updates": {
        "Enabled": true,
        "ProductId": "IPC.Gateway",
        "UpdateDirectory": "Data/Updates",
        "InstallDirectory": "",
        "MaxPackageMegabytes": 1024,
        "KeepRollbackCount": 5
      }
    },
    "Watchdog": {
      "Enabled": true,
      "CheckIntervalSeconds": 10,
      "StartupGraceSeconds": 10,
      "RuntimeNoProgressSeconds": 180,
      "RecoveryCooldownSeconds": 60,
      "RecoveryTimeoutSeconds": 30,
      "MaxRecoveriesPerWindow": 3,
      "RecoveryWindowMinutes": 10,
      "RequestHostStopOnUnrecoverable": false,
      "MaxHostRestartRequestsPerWindow": 2,
      "HostRestartProtectionWindowMinutes": 30,
      "StateDirectory": "Data/Watchdog"
    }
  }
}
