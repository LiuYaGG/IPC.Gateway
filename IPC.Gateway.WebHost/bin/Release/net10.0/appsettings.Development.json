{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "Database": {
      "Password": "123"
    },
    "Auth": {
      "Secret": "development-only-auth-secret-please-replace-in-production",
      "BootstrapAdminPassword": "Admin#12345678"
    },
    "Security": {
      "PasswordPolicy": {
        "Enabled": true,
        "MinLength": 12,
        "RequireUppercase": true,
        "RequireLowercase": true,
        "RequireDigit": true,
        "RequireSymbol": true
      },
      "AccountLockout": {
        "Enabled": true,
        "MaxFailedAttempts": 5,
        "LockoutMinutes": 15
      },
      "Tls": {
        "RequireHttps": false,
        "EnableHttpsRedirection": false,
        "EnableHsts": false
      },
      "ApiTokens": {
        "Enabled": true,
        "HeaderName": "X-API-Token",
        "RequireHttps": false,
        "Tokens": []
      },
      "SecretStorage": {
        "Enabled": true,
        "MasterKey": "",
        "EnvironmentVariableName": "IPC_GATEWAY_SECRET_KEY"
      }
    },
    "Maintenance": {
      "Updates": {
        "Enabled": true,
        "ProductId": "IPC.Gateway",
        "UpdateDirectory": "Data/Updates",
        "InstallDirectory": "",
        "MaxPackageMegabytes": 1024,
        "KeepRollbackCount": 5
      }
    }
  }
}
