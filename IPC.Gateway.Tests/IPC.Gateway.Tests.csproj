<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IncludeCommercialDriverPlugin Condition="'$(IncludeCommercialDriverPlugin)' == '' and Exists('..\IPC.Gateway.LegacyProtocolPlugins\IPC.Gateway.LegacyProtocolPlugins.csproj')">true</IncludeCommercialDriverPlugin>
    <IncludeCommercialDriverPlugin Condition="'$(IncludeCommercialDriverPlugin)' == ''">false</IncludeCommercialDriverPlugin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPC.Gateway.Licensing\IPC.Gateway.Licensing.csproj" />
    <ProjectReference Include="..\IPC.Gateway.Core\IPC.Gateway.Core.csproj" />
    <ProjectReference Include="..\IPC.Gateway.DataProcessing\IPC.Gateway.DataProcessing.csproj" />
    <ProjectReference Include="..\IPC.Gateway.FlowRules\IPC.Gateway.FlowRules.csproj" />
    <ProjectReference Include="..\IPC.Gateway.Scripting\IPC.Gateway.Scripting.csproj" />
    <ProjectReference Include="..\IPC.Gateway.LegacyProtocolPlugins\IPC.Gateway.LegacyProtocolPlugins.csproj"
                      Condition="'$(IncludeCommercialDriverPlugin)' == 'true'" />
    <ProjectReference Include="..\IPC.Gateway.Watchdog\IPC.Gateway.Watchdog.csproj" />
    <ProjectReference Include="..\IPC.Gateway.WebHost\IPC.Gateway.WebHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeCommercialDriverPlugin)' != 'true'">
    <Compile Remove="BacnetPackageMigrationTests.cs;BeckhoffAdsConfigurationTests.cs;CanOpenConfigurationTests.cs;Dnp3ConfigurationTests.cs;Dnp3RuntimeCompatibilityTests.cs;EtherNetIpConfigurationTests.cs;MitsubishiMcConfigurationTests.cs;MitsubishiMcFrameCodecTests.cs;MitsubishiMcUdpRetryTests.cs;ModbusAsciiConfigurationTests.cs;MqttSouthboundConfigurationTests.cs;OmronFinsConfigurationTests.cs;OmronFinsUdpClientTests.cs;OpcUaClientEndpointTests.cs;OpcUaClientIntegrationTests.cs;OpcUaPluginLoadTests.cs;ProtocolFailureClassificationTests.cs;RockwellCipConfigurationTests.cs;RockwellPcccConfigurationTests.cs;SiemensS7ConfigurationTests.cs;SnmpConfigurationTests.cs;TcpProtocolAsyncClientTests.cs" />
  </ItemGroup>

</Project>
