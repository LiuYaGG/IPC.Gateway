<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPC.Gateway.Core\IPC.Gateway.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Opc.UaFx.Client" Version="2.53.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="Talk.BACnet" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="IPC.Gateway.LegacyProtocolPlugins.ipc-driver.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyLegacyProtocolPluginToWebHost" AfterTargets="Build">
    <PropertyGroup>
      <GatewayDriversDir>..\IPC.Gateway.WebHost\bin\$(Configuration)\net10.0\Drivers\</GatewayDriversDir>
    </PropertyGroup>
    <MakeDir Directories="$(GatewayDriversDir)" />
    <ItemGroup>
      <LegacyProtocolPluginFiles Include="$(TargetDir)*.*"
                                 Exclude="$(TargetDir)IPC.Gateway.Core.*;$(TargetDir)*.pdb" />
      <LegacyProtocolPluginRuntimeFiles Include="$(TargetDir)runtimes\**\System.IO.Ports*.*;$(TargetDir)runtimes\**\libSystem.IO.Ports.Native.*;$(TargetDir)runtimes\**\System.Management.dll;$(TargetDir)runtimes\**\System.Private.ServiceModel.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LegacyProtocolPluginFiles)"
          DestinationFolder="$(GatewayDriversDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LegacyProtocolPluginRuntimeFiles)"
          DestinationFolder="$(GatewayDriversDir)runtimes\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
